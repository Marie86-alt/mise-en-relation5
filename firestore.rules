rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          userDoc(request.auth.uid).data.role == 'admin'
          || userDoc(request.auth.uid).data.isAdmin == true
        );
    }

    function isPublicAidantProfile() {
      return resource.data.isAidant == true
        && resource.data.isVerified == true
        && resource.data.isSuspended != true
        && resource.data.isDeleted != true;
    }

    function ownsUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == null
        && request.resource.data.role == 'user'
        && request.resource.data.isAdmin == false
        && request.resource.data.isVerified == false
        && request.resource.data.isSuspended == false
        && request.resource.data.isDeleted == false;
    }

    function ownerEditableUserKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'experience',
        'tarifHeure',
        'description',
        'isAidant',
        'secteur',
        'secteurs',
        'genre',
        'updatedAt'
      ]);
    }

    function isConversationParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function willBeConversationParticipant() {
      return signedIn() && request.auth.uid in request.resource.data.participants;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isPublicAidantProfile();
      allow list: if isAdmin() || isPublicAidantProfile();
      allow create: if ownsUserCreate(uid) || isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && ownerEditableUserKeysOnly());
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get, list: if isAdmin() || isConversationParticipant();
      allow create: if isAdmin() || willBeConversationParticipant();
      allow update: if isAdmin() || isConversationParticipant();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin()
          || (
            signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
        allow create: if isAdmin()
          || (
            signedIn()
            && request.auth.uid == request.resource.data.expediteurId
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
        allow update, delete: if isAdmin();
      }
    }

    // Avis : déposés via le backend (POST /api/reviews), qui recalcule la note de l'aidant.
    // La création directe reste tolérée pour l'application publiée (1.0.2), bornée : note entière
    // 1..5, auteur = client connecté ET participant de la conversation évaluée. À fermer
    // (allow create: if false) quand cette version ne sera plus en circulation.
    match /avis/{avisId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.clientId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.conversationId is string
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update, delete: if isAdmin();
    }

    // Notes agrégées : écrites uniquement par le serveur (le client les lit sur users.averageRating)
    match /aidant_stats/{aidantId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // `services` et `transactions` sont écrits UNIQUEMENT par le serveur (webhook Stripe,
    // Firebase Admin SDK, qui contourne ces règles). Le client lit ce qui le concerne.
    match /services/{serviceId} {
      allow get, list: if isAdmin()
        || (signedIn() && (
          request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.aidantId
        ));
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow get, list: if isAdmin()
        || (signedIn() && (
          request.auth.uid == resource.data.clientId
          || request.auth.uid == resource.data.aidantId
        ));
      allow create, update, delete: if false;
    }

    // Échecs de paiement tracés par le webhook : lecture admin uniquement
    match /payment_failures/{failureId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Configuration de la plateforme (tarifs…) : lue par l'app, modifiée par les administrateurs
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
